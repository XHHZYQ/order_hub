# 数据库连接（WSL2 Docker 容器 postgresql-container，库/用户/密码均为 order-hub）
DATABASE_URL=postgresql+psycopg://order-hub:order-hub@localhost:5432/order-hub

# JWT 配置
JWT_SECRET=order-hub-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 是否启用进程内定时调度
SCHEDULER_ENABLED=true

# 允许跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 应用时区（用于接口时间字符串输出）
TIMEZONE=Asia/Shanghai

# 分页
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
