# 数据库连接（WSL2 Docker 容器 postgresql-container，库/用户/密码均为 order-hub）
DATABASE_URL=postgresql+psycopg://order_hub:order_hub@127.0.0.1:5433/order_hub

# JWT 配置（JWT_SECRET 建议不少于 32 字节，避免 HS256 密钥长度告警）
JWT_SECRET=order-hub-dev-secret-please-change-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 是否启用进程内定时调度
SCHEDULER_ENABLED=true

# 允许跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 应用时区（用于接口时间字符串输出）
TIMEZONE=Asia/Shanghai

# 分页
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
